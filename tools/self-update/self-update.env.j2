# Generated by tools/self-update/install_self-update.yml -- do not edit.
#
# Sourced by ~/_dotfiles/tools/self-update/self-update.sh. Lives outside the
# repo so `git pull` never touches it while the script is running.

# Inventory entry that provisioned this account. On a multi-user host each
# account has its own entry, so `hostname -s` is not enough.
DOTFILES_LIMIT="{{ inventory_hostname }}"

# Inventory file that entry lives in, relative to ~/_dotfiles. A machine
# bootstrapped locally is described by its own localhost.yml and may not be in
# the checked-in inventory.yml at all; on a multi-user host each account's
# localhost.yml describes that account, not the machine's admin.
DOTFILES_INVENTORY="{{ ansible_inventory_sources | first | basename }}"

# Standard (non-admin) accounts skip every task needing sudo or write access
# to a shared prefix -- that work belongs to the admin, and an unattended run
# must never block on a password prompt.
DOTFILES_SKIP_TAGS="{{ 'system' if dotfiles_user_role | default('admin') == 'standard' else '' }}"
